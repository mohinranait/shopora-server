// use prisma-8
model Media {
  id               String            @id @default(uuid())
  url              String
  publicId         String            @unique
  format           String?
  bytes            Int?
  width            Int?
  height           Int?
  originalFilename String?
  folder           String?
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerId         String?
  seller           SellerProfile?    @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  useMedias        UseMedia[]
  createdAt        TimestamptzString @default(now())
}

model UseMedia {
  id              String                     @id @default(uuid())
  mediaId         String
  media           Media                      @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  alt             String?
  description     String?
  userId          String
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerId        String?
  seller          SellerProfile?             @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  // Reverse relations to models using this media
  productsMain    Product[]                  @relation("ProductMainImage")
  productImages   ProductImage[]
  productVariants ProductVariant[]
  brands          Brand[]
  categories      Category[]
  bannersMain     Banner[]                   @relation("BannerDesktopImage")
  bannersMobile   Banner[]                   @relation("BannerMobileImage")
  slidersMain     Slider[]                   @relation("SliderDesktopImage")
  slidersMobile   Slider[]                   @relation("SliderMobileImage")
  userAvatars     User[]                     @relation("UserAvatar")
  sellerLogos     SellerProfile[]            @relation("SellerLogo")
  sellerBanners   SellerProfile[]            @relation("SellerBanner")

  createdAt       TimestamptzString          @default(now())
  updatedAt       temporal.updatedAtString()
}
