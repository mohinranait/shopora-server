// use prisma-8
model Coupon {
  id                String                     @id @default(uuid())
  code              String                     @unique
  discountType      String // "PERCENTAGE" | "FIXED"
  discountValue     Float
  minOrderAmount    Float                      @default(0.0)
  maxDiscountAmount Float?
  usageLimit        Int?
  usedCount         Int                        @default(0)
  startDate         TimestamptzString?
  endDate           TimestamptzString?
  isActive          Boolean                    @default(true)
  sellerId          String? // NULL = Platform-wide; or specific SellerProfile id
  createdAt         TimestamptzString          @default(now())
  updatedAt         temporal.updatedAtString()
}

model Banner {
  id            String                     @id @default(uuid())
  title         String
  subtitle      String?
  linkUrl       String?
  imageId       String?
  image         UseMedia?                  @relation("BannerDesktopImage", fields: [imageId], references: [id], onDelete: SetNull)
  mobileImageId String?
  mobileImage   UseMedia?                  @relation("BannerMobileImage", fields: [mobileImageId], references: [id], onDelete: SetNull)
  position      String                     @default("HERO_SLIDER") // "HERO_SLIDER" | "PROMO_GRID" | "MIDDLE_STRIP" | "POPUP"
  displayOrder  Int                        @default(0)
  isActive      Boolean                    @default(true)
  startDate     TimestamptzString?
  endDate       TimestamptzString?
  createdAt     TimestamptzString          @default(now())
  updatedAt     temporal.updatedAtString()
}

model Slider {
  id            String                     @id @default(uuid())
  title         String?
  subtitle      String?
  description   String?
  badgeText     String?                    // "New Arrival", "Hot Deal", "Limited Offer"
  type          String                     @default("IMAGE_BG_CONTENT") // "IMAGE_ONLY" | "IMAGE_BG_CONTENT" | "CONTENT_ONLY"
  linkUrl       String?                    // Click destination URL
  buttonText    String?                    @default("Shop Now")
  bgGradient    String?                    // e.g. "from-indigo-900 via-purple-900 to-slate-950"
  bgColor       String?                    // Hex or CSS color
  textColor     String?                    @default("LIGHT") // "LIGHT" | "DARK"
  displayOrder  Int                        @default(0)
  isActive      Boolean                    @default(true)
  imageId       String?
  image         UseMedia?                  @relation("SliderDesktopImage", fields: [imageId], references: [id], onDelete: SetNull)
  mobileImageId String?
  mobileImage   UseMedia?                  @relation("SliderMobileImage", fields: [mobileImageId], references: [id], onDelete: SetNull)
  startDate     TimestamptzString?
  endDate       TimestamptzString?
  createdAt     TimestamptzString          @default(now())
  updatedAt     temporal.updatedAtString()
}

model WebsiteSetting {
  id          String                     @id @default(uuid())
  key         String                     @unique
  value       Json
  group       String                     @default("GENERAL") // "GENERAL" | "COMMISSION" | "SHIPPING" | "SEO" | "PAYMENT"
  description String?
  updatedAt   temporal.updatedAtString()
}

model Notification {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String            @default("SYSTEM") // "ORDER" | "PAYOUT" | "PRODUCT_APPROVAL" | "SYSTEM"
  link      String?
  isRead    Boolean           @default(false)
  createdAt TimestamptzString @default(now())
}
