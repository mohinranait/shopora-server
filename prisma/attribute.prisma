// use prisma-8

model Attribute {
  id                     String                         @id @default(uuid())
  name                   String                         @unique // e.g. "Color", "Size", "Storage", "Material"
  slug                   String                         @unique // e.g. "color", "size", "storage", "material"
  type                   String                         @default("SELECT") // "TEXT" | "COLOR" | "BUTTON" | "SELECT" | "RADIO"
  description            String?
  isActive               Boolean                        @default(true)
  displayOrder           Int                            @default(0)
  values                 AttributeValue[]
  productAttributes      ProductAttribute[]
  variantAttributeValues ProductVariantAttributeValue[]
  createdAt              TimestamptzString              @default(now())
  updatedAt              temporal.updatedAtString()
}

model AttributeValue {
  id                     String                         @id @default(uuid())
  attributeId            String
  attribute              Attribute                      @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value                  String                         // e.g. "Red", "Blue", "XL", "128GB"
  colorCode              String?                        // e.g. "#FF0000" for visual color swatches
  displayOrder           Int                            @default(0)
  productAttributeValues ProductAttributeValue[]
  variantAttributeValues ProductVariantAttributeValue[]
  createdAt              TimestamptzString              @default(now())
}

model ProductAttribute {
  id          String                  @id @default(uuid())
  productId   String
  product     Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  isVariation Boolean                 @default(false) // true if used for generating variants, false for general specs
  values      ProductAttributeValue[]
  createdAt   TimestamptzString       @default(now())
}

model ProductAttributeValue {
  id                 String           @id @default(uuid())
  productAttributeId String
  productAttribute   ProductAttribute @relation(fields: [productAttributeId], references: [id], onDelete: Cascade)
  attributeValueId   String?
  attributeValue     AttributeValue?  @relation(fields: [attributeValueId], references: [id], onDelete: SetNull)
  customValue        String?          // For non-predefined custom specifications
  createdAt          TimestamptzString @default(now())
}

model ProductVariantAttributeValue {
  id               String         @id @default(uuid())
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeId      String
  attribute        Attribute      @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)
  createdAt        TimestamptzString @default(now())
}
