// use prisma-8
model Category {
  id           String                     @id @default(uuid())
  name         String
  slug         String                     @unique
  description  String?
  icon         String?
  imageId      String?
  image        UseMedia?                  @relation(fields: [imageId], references: [id], onDelete: SetNull)
  parentId     String?
  parent       Category?                  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]                 @relation("CategoryHierarchy")
  isActive     Boolean                    @default(true)
  displayOrder Int                        @default(0)
  products     Product[]
  createdAt    TimestamptzString          @default(now())
  updatedAt    temporal.updatedAtString()
}

model Brand {
  id          String                     @id @default(uuid())
  name        String
  slug        String                     @unique
  description String?
  website     String?
  logoId      String?
  logo        UseMedia?                  @relation(fields: [logoId], references: [id], onDelete: SetNull)
  isActive    Boolean                    @default(true)
  products    Product[]
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()
}

model Product {
  id                  String                     @id @default(uuid())
  name                String
  slug                String                     @unique
  sku                 String                     @unique
  shortDescription    String?
  description         String
  categoryId          String
  category            Category                   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId             String?
  brand               Brand?                     @relation(fields: [brandId], references: [id], onDelete: SetNull)
  sellerId            String? // NULL = Platform-owned (Admin direct product)
  seller              SellerProfile?             @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  isPlatformOwned     Boolean                    @default(false)
  approvalStatus      String                     @default("PENDING") // "DRAFT" | "PENDING" | "APPROVED" | "REJECTED"
  rejectionReason     String?
  status              String                     @default("PUBLISHED") // "PUBLISHED" | "UNPUBLISHED" | "ARCHIVED"
  productType         String                     @default("SIMPLE") // "SIMPLE" | "VARIABLE"
  basePrice           Float
  comparePrice        Float?
  costPrice           Float?
  stock               Int                        @default(0)
  lowStockThreshold   Int                        @default(5)
  mainImageId         String?
  mainImage           UseMedia?                  @relation("ProductMainImage", fields: [mainImageId], references: [id], onDelete: SetNull)
  images              ProductImage[]
  variants            ProductVariant[]
  productAttributes   ProductAttribute[]
  reviews             ProductReview[]
  questions           ProductQuestion[]
  orderItems          OrderItem[]
  wishlistItems       WishlistItem[]
  cartItems           CartItem[]
  ratingAverage       Float                      @default(0.0)
  ratingCount         Int                        @default(0)
  totalSold           Int                        @default(0)
  isFeatured          Boolean                    @default(false)
  isTrending          Boolean                    @default(false)
  videoUrl            String?
  trackStock          Boolean                    @default(true)
  isFreeShipping      Boolean                    @default(false)
  dimensions          Json?                      // { length, width, height }
  metaTitle           String?
  metaDescription     String?
  metaKeywords        String?
  tags                String[]
  bundleProductIds    String[]                   @default([])
  warranty            String?
  weightKg            Float?
  createdAt           TimestamptzString          @default(now())
  updatedAt           temporal.updatedAtString()
}

model ProductImage {
  id           String            @id @default(uuid())
  productId    String
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  altText      String?
  displayOrder Int               @default(0)
  isPrimary    Boolean           @default(false)
  imageId      String?
  image        UseMedia?         @relation(fields: [imageId], references: [id], onDelete: Cascade)
  createdAt    TimestamptzString @default(now())
}

model ProductVariant {
  id                String                         @id @default(uuid())
  productId         String
  product           Product                        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String                         @unique
  title             String                         // e.g. "Red / XL"
  price             Float
  comparePrice      Float?
  costPrice         Float?
  stock             Int                            @default(0)
  lowStockThreshold Int                            @default(5)
  imageId           String?
  image             UseMedia?                      @relation(fields: [imageId], references: [id], onDelete: SetNull)
  attributes        Json?                          // Cached key-value helper e.g. {"Color": "Red", "Size": "XL"}
  attributeValues   ProductVariantAttributeValue[]
  barcode           String?
  weightKg          Float?
  dimensions        Json?                          // { length, width, height }
  isDefault         Boolean                        @default(false)
  isActive          Boolean                        @default(true)
  orderItems        OrderItem[]
  cartItems         CartItem[]
  createdAt         TimestamptzString              @default(now())
  updatedAt         temporal.updatedAtString()
}

model ProductQuestion {
  id             String            @id @default(uuid())
  productId      String
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation("QuestionAsker", fields: [userId], references: [id], onDelete: Cascade)
  question       String
  answer         String?
  answeredBy     String?           // User ID of responder
  answeredByUser User?             @relation("QuestionAnswerer", fields: [answeredBy], references: [id], onDelete: SetNull)
  answeredAt     TimestamptzString?
  isApproved     Boolean           @default(true)
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}
