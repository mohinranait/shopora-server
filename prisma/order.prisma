// use prisma-8
model Order {
  id                   Int                        @id @default(autoincrement())
  orderNumber          String                     @unique // e.g. "SHO-20261018-001"
  userId               Int?
  user                 User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestEmail           String?
  guestPhone           String?
  shippingAddress      Json
  billingAddress       Json?
  subtotal             Float
  discount             Float                      @default(0.0)
  shippingFee          Float                      @default(0.0)
  tax                  Float                      @default(0.0)
  totalAmount          Float
  paymentMethod        String                     @default("COD") // "COD" | "STRIPE" | "BKASH" | "SSLCOMMERZ"
  paymentStatus        String                     @default("PENDING") // "PENDING" | "PAID" | "FAILED" | "REFUNDED"
  paymentTransactionId String?
  orderStatus          String                     @default("PENDING") // "PENDING" | "CONFIRMED" | "PROCESSING" | "SHIPPED" | "DELIVERED" | "CANCELLED" | "RETURNED"
  couponCode           String?
  notes                String?
  items                OrderItem[]
  subOrders            SubOrder[]
  returnRequests       ReturnRequest[]
  createdAt            TimestamptzString          @default(now())
  updatedAt            temporal.updatedAtString()
}

model SubOrder {
  id               Int                        @id @default(autoincrement())
  subOrderNumber   String                     @unique // e.g. "SHO-20261018-001-V1"
  orderId          Int
  order            Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId         Int? // NULL = Platform-owned order item
  seller           SellerProfile?             @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  isPlatformOwned  Boolean                    @default(false)
  subtotal         Float
  shippingFee      Float                      @default(0.0)
  tax              Float                      @default(0.0)
  totalAmount      Float
  commissionRate   Float                      @default(0.0)
  commissionAmount Float                      @default(0.0)
  sellerEarnings   Float                      @default(0.0)
  isPayoutSettled  Boolean                    @default(false)
  status           String                     @default("PENDING") // "PENDING" | "CONFIRMED" | "PROCESSING" | "SHIPPED" | "DELIVERED" | "CANCELLED" | "RETURNED"
  trackingNumber   String?
  courierName      String?
  items            OrderItem[]
  createdAt        TimestamptzString          @default(now())
  updatedAt        temporal.updatedAtString()
}

model OrderItem {
  id             Int               @id @default(autoincrement())
  orderId        Int
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subOrderId     Int?
  subOrder       SubOrder?         @relation(fields: [subOrderId], references: [id], onDelete: SetNull)
  productId      Int
  product        Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      Int?
  variant        ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sellerId       Int? // Seller id or NULL for platform
  productName    String
  variantTitle   String?
  productImage   String?
  sku            String?
  price          Float
  quantity       Int
  totalPrice     Float
  returnRequests ReturnRequest[]
  createdAt      TimestamptzString @default(now())
}

model ReturnRequest {
  id              Int                        @id @default(autoincrement())
  orderId         Int
  order           Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId     Int
  orderItem       OrderItem                  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  userId          Int
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason          String
  customerComment String?
  images          String[]
  status          String                     @default("REQUESTED") // "REQUESTED" | "APPROVED" | "REJECTED" | "COMPLETED"
  refundAmount    Float
  adminNote       String?
  createdAt       TimestamptzString          @default(now())
  updatedAt       temporal.updatedAtString()
}
