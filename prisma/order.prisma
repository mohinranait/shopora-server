// use prisma-8
model Order {
  id                   String                     @id @default(uuid())
  orderNumber          String                     @unique // e.g. "SHO-20261018-001"
  userId               String?
  user                 User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestEmail           String?
  guestPhone           String?
  shippingAddress      Json
  billingAddress       Json?
  subtotal             Numeric(12, 2)
  discount             Numeric(12, 2)                      @default(0.0)
  shippingFee          Numeric(12, 2)                      @default(0.0)
  tax                  Numeric(12, 2)                      @default(0.0)
  totalAmount          Numeric(12, 2)
  paymentMethod        String                     @default("COD") // "COD" | "STRIPE" | "BKASH" | "SSLCOMMERZ"
  paymentStatus        String                     @default("PENDING") // "PENDING" | "PAID" | "FAILED" | "REFUNDED"
  paymentTransactionId String?
  orderStatus          String                     @default("PENDING") // "PENDING" | "CONFIRMED" | "PROCESSING" | "SHIPPED" | "DELIVERED" | "CANCELLED" | "RETURNED"
  couponCode           String?
  notes                String?
  items                OrderItem[]
  subOrders            SubOrder[]
  returnRequests       ReturnRequest[]
  createdAt            TimestamptzString          @default(now())
  updatedAt            temporal.updatedAtString()

  @@index([userId, createdAt])
  @@index([orderStatus, createdAt])
  @@index([paymentStatus])
  @@index([guestPhone])
  @@index([createdAt])
}

model SubOrder {
  id               String                     @id @default(uuid())
  subOrderNumber   String                     @unique // e.g. "SHO-20261018-001-V1"
  orderId          String
  order            Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId         String? // NULL = Platform-owned order item
  seller           SellerProfile?             @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  isPlatformOwned  Boolean                    @default(false)
  subtotal         Numeric(12, 2)
  shippingFee      Numeric(12, 2)                      @default(0.0)
  tax              Numeric(12, 2)                      @default(0.0)
  totalAmount      Numeric(12, 2)
  commissionRate   Numeric(5, 2)                      @default(0.0)
  commissionAmount Numeric(12, 2)                      @default(0.0)
  sellerEarnings   Numeric(12, 2)                      @default(0.0)
  isPayoutSettled  Boolean                    @default(false)
  status           String                     @default("PENDING") // "PENDING" | "CONFIRMED" | "PROCESSING" | "SHIPPED" | "DELIVERED" | "CANCELLED" | "RETURNED"
  trackingNumber   String?
  courierName      String?
  consignmentId    String?
  shippingCost     Numeric(12, 2)                      @default(0.0)
  escrowHoldUntil  TimestamptzString?
  escrowStatus     String                     @default("PENDING") // "PENDING" | "HELD" | "RELEASED" | "REFUNDED"
  escrowReleasedAt TimestamptzString?
  items            OrderItem[]
  createdAt        TimestamptzString          @default(now())
  updatedAt        temporal.updatedAtString()

  @@index([orderId])
  @@index([sellerId, status, createdAt])
  @@index([status])
  @@index([trackingNumber])
}

model OrderItem {
  id             String            @id @default(uuid())
  orderId        String
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subOrderId     String?
  subOrder       SubOrder?         @relation(fields: [subOrderId], references: [id], onDelete: SetNull)
  productId      String
  product        Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId      String?
  variant        ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sellerId       String? // Seller id or NULL for platform
  productName    String
  variantTitle   String?
  productImage   String?
  sku            String?
  price          Numeric(12, 2)
  costPrice      Numeric(12, 2)?
  quantity       Int
  totalPrice     Numeric(12, 2)
  returnRequests ReturnRequest[]
  createdAt      TimestamptzString @default(now())

  @@index([orderId])
  @@index([subOrderId])
  @@index([productId])
  @@index([variantId])
  @@index([sellerId])
}

model ReturnRequest {
  id              String                     @id @default(uuid())
  orderId         String
  order           Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem                  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  userId          String
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason          String
  customerComment String?
  images          String[]
  status          String                     @default("REQUESTED") // "REQUESTED" | "APPROVED" | "REJECTED" | "COMPLETED"
  refundAmount    Numeric(12, 2)
  adminNote       String?
  createdAt       TimestamptzString          @default(now())
  updatedAt       temporal.updatedAtString()

  @@index([orderId])
  @@index([orderItemId])
  @@index([userId, createdAt])
  @@index([status])
}
