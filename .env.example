# Shopora Multi-Vendor E-Commerce Platform - Backend Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL Database Connection URL (Prisma 8)
DATABASE_URL="postgres://username:password@host:5432/shopora_db?sslmode=require"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="your_super_secret_jwt_access_key"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="your_super_secret_jwt_refresh_key"
JWT_REFRESH_EXPIRES_IN="7d"

# Default Platform Commission Rate (Percentage)
DEFAULT_COMMISSION_RATE=10.0

# Cloudinary Storage Configuration
CLOUDINARY_NAME="your_cloudinary_cloud_name"
CLOUDINARY_KEY="your_cloudinary_api_key"
CLOUDINARY_SECRET="your_cloudinary_api_secret"
CLOUDINARY_FOLDER="shopora"
